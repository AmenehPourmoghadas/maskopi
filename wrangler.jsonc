{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in Cloudflare: https://ai.maskopi.workers.dev
  "name": "ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/join/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    "CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "VOICE_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
}
